# npm publish configuration
access=public
tag=latest

# Registry settings
registry=https://registry.npmjs.org/

# Save exact versions for dependencies
save-exact=true

# Allow scripts during installation
ignore-scripts=false

# Always use strict SSL
strict-ssl=true

# Disable package-lock generation during publish
package-lock=false

# Publish only files listed in package.json "files" field
# This ensures only necessary files are published to npm
