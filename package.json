{
  "name": "juice-email-cli",
  "version": "1.0.0",
  "description": "CLI tool to generate email-client-compatible HTML with juice (CSS inlining) + Mustache templating + minification",
  "main": "src/index.js",
  "bin": {
    "juice": "bin/juice.js"
  },
  "scripts": {
    "start": "node bin/juice.js",
    "test": "node bin/juice.js --help",
    "postinstall": "node bin/juice.js --install",
    "preuninstall": "node bin/juice.js --uninstall"
  },
  "keywords": [
    "email",
    "html",
    "css-inline",
    "juice",
    "email-template",
    "mustache",
    "minify",
    "html-email"
  ],
  "author": "",
  "license": "MIT",
  "homepage": "https://gitee.com/siriussupreme/juice-cli",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/siriussupreme/juice-cli.git"
  },
  "bugs": {
    "url": "https://gitee.com/siriussupreme/juice-cli/issues"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "html-minifier-terser": "^7.2.0",
    "js-yaml": "^4.1.0",
    "juice": "^10.0.0",
    "mustache": "^4.2.0",
    "ora": "^5.4.1"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "files": [
    "bin/",
    "src/",
    "defaults/"
  ]
}
